# Pocket ID is VoCat's only login provider. See docs/POCKET_ID.md.
# Copy to a protected .env file for Docker Compose and restrict it to mode 0600.
# These values are public configuration, not credentials.
VOCAT_OIDC_ISSUER=https://auth.bytespark.app
VOCAT_OIDC_CLIENT_ID=894ea818-24bc-4356-92a8-1658742edebf
VOCAT_OIDC_REDIRECT_URL=https://vo.0o.tn/api/auth/oidc/callback
# For a confidential client, supply VOCAT_OIDC_CLIENT_SECRET securely.
# Leave it empty only when Pocket ID explicitly allows a public client.
VOCAT_OIDC_CLIENT_SECRET=
